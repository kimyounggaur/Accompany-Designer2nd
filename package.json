{
  "name": "accompany-designer-2",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && node scripts/check-ui-strings.mjs",
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "test:e2e": "node scripts/make-fixtures.mjs && playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "immer": "11.2.10",
    "lucide-react": "1.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
